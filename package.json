{
  "author": "devbux",
  "bin": {
    "typesafe-mcp": "dist/index.js"
  },
  "bugs": {
    "url": "https://github.com/devbux/typesafe-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  },
  "description": "A Model Context Protocol server for TypeSafe AI's Jev decision model, with typed Choice, Score, Noul and Box tools and image inputs.",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/devbux/typesafe-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "typesafe",
    "jev",
    "ai",
    "decision-model",
    "typescript"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "name": "@devbux/typesafe-mcp",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devbux/typesafe-mcp.git"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.2.1"
}
